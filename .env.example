FHIR_BASE_URL=https://hapi.fhir.org/baseR4
# Optional — forwarded to FHIR as `Authorization: Bearer <token>` when set.
# Leave unset for the public HAPI test server.
FHIR_SERVER_TOKEN=

# Optional. Server-side fetch timeout for FHIR calls (ms). Defaults to 30s.
# Bump to 60s+ if running against a slow public tenant; lower for production.
# FHIR_TIMEOUT_MS=30000

# Required for the prior-auth feature. Get one at https://aistudio.google.com/apikey.
# Server-only — never exposed to the browser.
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash (free-tier friendly).
# Override to gemini-2.5-pro (or another available model) once billing is enabled.
GEMINI_MODEL=gemini-2.5-flash

# Hardcoded demo auth. If unset, the route handler falls back to demo/demo123.
# Replace with stronger values when sharing the demo URL publicly.
AUTH_USERNAME=demo
AUTH_PASSWORD=demo123
